{
  "name": "smart-kitchen-inventory-workspace",
  "version": "1.0.0",
  "description": "Smart Kitchen Inventory - Full-stack grocery and kitchen stock management system",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "seed": "node server/db/seed.js",
    "postinstall": "npm --prefix client install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.11.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
